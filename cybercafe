  <script>
    $(document).ready(function () {
      
      let basePrice = 40;
      let currentStation = 'PS5';
      let timerInterval = null;
      let timeLeft = 30;

      let selectionData = {
        ps5: { game: null, controls: null },
        pc: { machine: null },
        arcade: { game: null }
      };

      // --- FUNCIÓN PARA CAMBIAR EL TEXTO DE LA PROMOCIÓN ---
      function updatePromoText(station) {
        let text1 = "", text2 = "";
        if (station === 'PS5') {
          text1 = "PROMO PS5: 2X1 EN HORAS";
          text2 = "COMBO GAMER GRATIS EN PS5";
        } else if (station === 'PC') {
          text1 = "PROMO PC: 1 HORA GRATIS";
          text2 = "TORNEO VALORANT ESTE VIERNES";
        } else if (station === 'Arcade') {
          text1 = "PROMO ARCADE: FICHAS X2";
          text2 = "TORNEO STREET FIGHTER";
        }
        
        // Actualizamos el HTML del marquee
        $('#promoText').html(`
          <span>${text1}</span>
          <span>${text2}</span>
          <span>${text1}</span>
          <span>${text2}</span>
        `);
      }

      // --- LÓGICA DE PROMOCIONES ---
      $('#btnOpenPromos').on('click', function() {
        $('#modal-promos').fadeIn(300);
      });
      
      $('.close-promos').on('click', function() {
        $('#modal-promos').fadeOut(300);
      });

      // --- LÓGICA DEL PANEL DERECHO (CALCULADORA vs ESPECIFICACIONES) ---
      function showSpecs(type) {
        $('#calculatorPanel').hide(); // Ocultar calculadora
        $('.panel-content').hide(); // Ocultar todos los contenidos
        
        $('#panel-' + type).fadeIn(200); // Mostrar el contenido elegido
        $('#specsPanel').addClass('active'); // Mostrar el panel de especificaciones
        
        // Cambiar el título del panel
        let title = "";
        let icon = "";
        if (type === 'ps5') { title = "Especificaciones PS5"; icon = "fa-playstation"; }
        if (type === 'pc') { title = "Especificaciones PC"; icon = "fa-desktop"; }
        if (type === 'arcade') { title = "Especificaciones Arcade"; icon = "fa-ghost"; }
        
        $('#specsTitle').html(`<i class="fa-brands ${icon}"></i> ${title}`);
      }

      function hideSpecs() {
        $('#specsPanel').removeClass('active'); // Ocultar panel de especificaciones
        $('#calculatorPanel').fadeIn(200); // Mostrar calculadora de nuevo
      }

      $('#btnCloseSpecs').on('click', function() {
        hideSpecs();
      });

      // 1. CLIC EN LA TARJETA (Abre el panel de specs y cambia promo)
      $('.station-card__content').on('click', function () {
        let card = $(this).closest('.station-card');
        $('.station-card').removeClass('active');
        card.addClass('active');
        
        basePrice = parseInt(card.data('price'));
        currentStation = card.data('station').toUpperCase();
        if(currentStation === 'ARCADE') currentStation = 'Arcade';
        
        calcularTotal();
        let stationType = card.data('station');
        
        showSpecs(stationType); // Reemplaza la calculadora
        updatePromoText(currentStation); // Cambia la promo
      });

      // 2. BOTÓN DE ESPECIFICACIONES (Hace lo mismo)
      $('.btn-specs').on('click', function (e) {
        e.stopPropagation();
        let type = $(this).data('target');
        
        let card = $(this).closest('.station-card');
        $('.station-card').removeClass('active');
        card.addClass('active');
        basePrice = parseInt(card.data('price'));
        currentStation = card.data('station').toUpperCase();
        if(currentStation === 'ARCADE') currentStation = 'Arcade';
        calcularTotal();

        // Si ya está abierto, lo cierra. Si no, lo abre.
        if ($('#specsPanel').hasClass('active') && $('#panel-' + type).is(':visible')) {
          hideSpecs();
        } else {
          showSpecs(type);
          updatePromoText(currentStation);
        }
      });

      // 3. BOTONES DE RENT HOUR (Abre modales flotantes de selección)
      $('.btn-rent').on('click', function (e) {
        e.stopPropagation();
        
        let card = $(this).closest('.station-card');
        $('.station-card').removeClass('active');
        card.addClass('active');
        basePrice = parseInt(card.data('price'));
        currentStation = card.data('station').toUpperCase();
        if(currentStation === 'ARCADE') currentStation = 'Arcade';
        calcularTotal();

        let targetId = $(this).data('target');
        $('#' + targetId).fadeIn(300);
      });

      $('.close-selection').on('click', function () {
        $(this).closest('.modal-overlay').fadeOut(300);
      });

      // 4. LÓGICA DE SELECCIÓN EN TARJETAS
      $('.selection-grid').on('click', '.selection-card', function () {
        if ($(this).find('.pc-status.occupied').length) return;
        $(this).siblings().removeClass('selected');
        $(this).addClass('selected');
      });

      // 5. CONFIRMAR SELECCIÓN
      $('.btn-confirm-selection').on('click', function () {
        let type = $(this).data('type');
        let modalId = '#modal-select-' + type;

        if (type === 'ps5') {
          let game = $('#ps5-games .selection-card.selected').data('value');
          let controls = $('#ps5-controls .selection-card.selected').data('value');
          if (!game || !controls) {
            alert('Por favor, selecciona un videojuego y la cantidad de controles.');
            return;
          }
          selectionData.ps5 = { game: game, controls: controls };
        } 
        else if (type === 'pc') {
          let machine = $('#pc-machines .selection-card.selected').data('value');
          if (!machine) {
            alert('Por favor, selecciona una máquina disponible.');
            return;
          }
          selectionData.pc = { machine: machine };
        } 
        else if (type === 'arcade') {
          let game = $('#arcade-games .selection-card.selected').data('value');
          if (!game) {
            alert('Por favor, selecciona un juego arcade.');
            return;
          }
          selectionData.arcade = { game: game };
        }

        $(modalId).fadeOut(300);

        setTimeout(function() {
          $('#btnConfirm').click();
        }, 400);
      });

      // 6. CALCULADORA
      $('#btnPlus').on('click', function () {
        let val = parseInt($('#hoursInput').val()) || 1;
        $('#hoursInput').val(val + 1);
        calcularTotal();
      });

      $('#btnMinus').on('click', function () {
        let val = parseInt($('#hoursInput').val()) || 1;
        if (val > 1) {
          $('#hoursInput').val(val - 1);
          calcularTotal();
        }
      });

      $('#snackSelect').on('change', function () {
        calcularTotal();
      });

      function calcularTotal() {
        let hours = parseInt($('#hoursInput').val()) || 1;
        let snackPrice = parseInt($('#snackSelect').val()) || 0;
        let total = (basePrice * hours) + snackPrice;
        $('#totalDisplay').text(total + ' BOB');
        return total;
      }

      // 7. MODAL DE RESERVA FINAL
      $('#btnConfirm').on('click', function () {
        let type = currentStation.toLowerCase();
        if (type === 'ps5' && (!selectionData.ps5.game || !selectionData.ps5.controls)) {
          alert('Debes configurar tu PS5 (juego y controles) antes de reservar. Haz clic en "Rent Hour".');
          return;
        }
        if (type === 'pc' && !selectionData.pc.machine) {
          alert('Debes seleccionar una máquina PC antes de reservar. Haz clic en "Rent Hour".');
          return;
        }
        if (type === 'arcade' && !selectionData.arcade.game) {
          alert('Debes seleccionar un juego Arcade antes de reservar. Haz clic en "Rent Hour".');
          return;
        }

        let hours = $('#hoursInput').val();
        let snackText = $('#snackSelect option:selected').text();
        let total = calcularTotal();

        $('#modalService').text(currentStation);
        $('#modalSnack').text(snackText);
        $('#modalHours').text(hours + ' h');
        $('#modalTotal').text(total + ' BOB');

        let $detailRow = $('#dynamicDetailRow');
        let $detailText = $('#modalDetail');

        if (type === 'ps5') {
          $detailRow.show();
          $detailText.text(selectionData.ps5.game + ' | ' + selectionData.ps5.controls);
        } else if (type === 'pc') {
          $detailRow.show();
          $detailText.text(selectionData.pc.machine);
        } else if (type === 'arcade') {
          $detailRow.show();
          $detailText.text(selectionData.arcade.game);
        } else {
          $detailRow.hide();
        }

        $('#modal').fadeIn(300);
        iniciarTemporizador();
      });

      // 8. TEMPORIZADOR Y PAGO
      function iniciarTemporizador() {
        clearInterval(timerInterval);
        timeLeft = 30;
        $('#timerText').text('00:' + timeLeft + 's');

        timerInterval = setInterval(function () {
          timeLeft--;
          $('#timerText').text('00:' + (timeLeft < 10 ? '0' : '') + timeLeft + 's');

          if (timeLeft <= 0) {
            clearInterval(timerInterval);
            cerrarModal();
            alert('⏰ Tiempo de confirmación expirado.');
          }
        }, 1000);
      }

      function cerrarModal() {
        $('#modal').fadeOut(300);
        clearInterval(timerInterval);
      }

      $('#btnCloseModal, #btnCancelModal').on('click', function () {
        cerrarModal();
      });

      $('#btnProcess').on('click', function () {
        clearInterval(timerInterval);
        $('#modal').fadeOut(300);
        $('#toast').fadeIn(300).delay(4000).fadeOut(300);
      });

      $('#btnCloseToast').on('click', function () {
        $('#toast').fadeOut(300);
      });

      $('.modal-overlay').on('click', function(e) {
        if (e.target === this) {
          $(this).fadeOut(300);
          if ($(this).attr('id') === 'modal') clearInterval(timerInterval);
        }
      });

      // Inicializar con PS5 activo y su promo
      updatePromoText('PS5');
      calcularTotal();
    });
  </script>
</body>
</html>
