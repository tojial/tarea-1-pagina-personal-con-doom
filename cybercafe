<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LevelUp Arcade Bar - Reserva</title>

  <!-- Fuentes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;800;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Iconos -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    /* ================= VARIABLES Y RESET ================= */
    :root {
      --bg-dark: #060714;
      --bg-panel: #0f1226;
      --bg-card: #141834;
      --neon-purple: #b23aff;
      --neon-blue: #00d2ff;
      --neon-green: #00ff88;
      --neon-red: #ff3366;
      --neon-yellow: #ffcc00;
      --text-main: #ffffff;
      --text-muted: #8b92b6;
      --border-color: #2a2e54;
      --font-title: 'Orbitron', sans-serif;
      --font-body: 'Rajdhani', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font-body);
      background-color: var(--bg-dark);
      color: var(--text-main);
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ================= HEADER ================= */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 15px 30px;
      background: rgba(6, 7, 20, 0.9);
      border-bottom: 1px solid var(--border-color);
      z-index: 100;
    }

    /* Anuncio de promociones dinámico */
    .header__promo-ad {
      display: flex;
      align-items: center;
      background: rgba(255, 204, 0, 0.1);
      border: 1px solid var(--neon-yellow);
      padding: 8px 15px;
      border-radius: 20px;
      cursor: pointer;
      transition: all 0.3s;
      max-width: 350px;
      overflow: hidden;
      position: relative;
    }
    .header__promo-ad:hover {
      background: rgba(255, 204, 0, 0.2);
      box-shadow: 0 0 15px rgba(255, 204, 0, 0.3);
    }
    .promo-marquee {
      display: flex;
      white-space: nowrap;
      animation: marquee 10s linear infinite;
    }
    .promo-marquee span {
      color: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      padding-right: 40px;
      font-family: var(--font-title);
      letter-spacing: 1px;
    }
    .promo-marquee span:nth-child(even) { color: var(--neon-yellow); }
    
    @keyframes marquee {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }

    /* Navegación y Usuario */
    .header__nav { display: flex; gap: 25px; align-items: center; }
    .header__nav a {
      color: var(--text-muted); text-decoration: none; font-weight: 600;
      font-size: 1rem; transition: all 0.3s; display: flex; align-items: center; gap: 8px; cursor: pointer;
    }
    .header__nav a:hover, .header__nav a.active { color: #fff; text-shadow: 0 0 10px var(--neon-purple); }
    .header__nav a.active {
      background: rgba(178, 58, 255, 0.2); padding: 8px 16px;
      border-radius: 20px; border: 1px solid var(--neon-purple);
    }

    .dropdown { position: relative; display: inline-block; }
    .header__nav a.btn-contact {
      background: rgba(255, 204, 0, 0.1); padding: 8px 16px; border-radius: 8px;
      border: 2px solid var(--neon-yellow); color: #fff; box-shadow: 0 0 10px rgba(255, 204, 0, 0.3);
    }
    .header__nav a.btn-contact:hover { background: var(--neon-yellow); color: #000; text-shadow: none; }
    .header__nav a.btn-contact i { color: var(--neon-yellow); transition: color 0.3s; }
    .header__nav a.btn-contact:hover i { color: #000; }

    .dropdown-content {
      display: none; position: absolute; right: 0; top: 100%;
      background-color: var(--bg-panel); min-width: 200px;
      box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.8);
      border: 1px solid var(--neon-yellow); border-radius: 8px;
      z-index: 1000; margin-top: 10px; overflow: hidden;
    }
    .dropdown-content a {
      color: var(--text-main); padding: 12px 16px; text-decoration: none;
      display: flex; align-items: center; gap: 10px; border-radius: 0; font-size: 0.95rem;
    }
    .dropdown-content a:hover { background-color: rgba(255, 204, 0, 0.15); color: var(--neon-yellow); text-shadow: none; }
    .dropdown-content a i { color: var(--neon-yellow); width: 20px; text-align: center; }
    .dropdown:hover .dropdown-content { display: block; animation: fadeInDown 0.3s ease forwards; }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .header__user { display: flex; align-items: center; }
    .user-avatar img { width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--neon-blue); object-fit: cover; transition: all 0.3s; cursor: pointer; }
    .user-avatar img:hover { box-shadow: 0 0 15px var(--neon-blue); }

    /* ================= MAIN LAYOUT ================= */
    .main-container { 
      display: flex; flex: 1; padding: 20px 30px; gap: 30px; align-items: flex-start; 
      position: relative; justify-content: center; max-width: 1400px; margin: 0 auto; width: 100%;
    }

    /* --- CENTER (STATIONS) --- */
    .center-content { 
      flex: 1; display: flex; flex-direction: column; gap: 20px; min-width: 0; 
    }
    .stations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

    .station-card { display: flex; flex-direction: column; gap: 10px; }

    .station-card__content {
      background: var(--bg-panel); border-radius: 20px; border: 2px solid transparent;
      padding: 15px; text-align: center; position: relative; cursor: pointer;
      transition: all 0.3s ease; overflow: hidden;
    }
    .station-card__content::before {
      content: ''; position: absolute; inset: 0; border-radius: 20px; padding: 2px;
      background: linear-gradient(45deg, var(--neon-purple), var(--neon-blue));
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude;
      opacity: 0; transition: opacity 0.3s;
    }
    .station-card.active .station-card__content::before { opacity: 1; }
    .station-card.active .station-card__content { box-shadow: 0 0 20px rgba(178, 58, 255, 0.4); transform: translateY(-5px); }

    .station-img { width: 100%; height: 160px; border-radius: 12px; object-fit: cover; margin-bottom: 15px; box-shadow: 0 5px 15px rgba(0,0,0,0.5); }
    .station-card h3 { font-family: var(--font-title); font-size: 1.4rem; margin-bottom: 5px; }
    .station-card p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 5px; }

    .station-card__buttons {
      display: flex; flex-direction: column; gap: 8px;
      background: var(--bg-panel); padding: 10px; border-radius: 15px; border: 1px solid var(--border-color);
    }

    .btn-specs { 
      background: transparent; border: 1px solid var(--neon-blue); color: var(--neon-blue); 
      padding: 10px 15px; border-radius: 10px; font-size: 0.9rem; font-weight: 600;
      cursor: pointer; width: 100%; transition: all 0.3s; 
      display: flex; align-items: center; justify-content: center; gap: 8px;
    }
    .btn-specs:hover { background: var(--neon-blue); color: #000; }

    .btn-rent { 
      background: linear-gradient(90deg, rgba(178,58,255,0.3), rgba(0,210,255,0.3)); 
      border: 1px solid var(--neon-purple); color: #fff; padding: 10px 15px; border-radius: 10px; 
      font-family: var(--font-title); font-size: 0.9rem; font-weight: 700; cursor: pointer; 
      width: 100%; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 8px; 
    }
    .btn-rent:hover { background: var(--neon-purple); box-shadow: 0 0 15px var(--neon-purple); }

    /* ================= PANEL DERECHO (Contenedor) ================= */
    .right-sidebar {
      width: 320px;
      flex-shrink: 0;
      position: relative;
      /* Altura mínima para que no salte el layout */
      min-height: 400px; 
    }

    /* Calculadora (Visible por defecto) */
    .calculator-panel { 
      background: var(--bg-panel); border: 1px solid var(--border-color); 
      border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 20px;
      width: 100%; height: 100%;
      transition: opacity 0.3s ease;
    }
    .calculator-panel.hidden {
      display: none;
    }

    /* Panel de Especificaciones (Oculto por defecto, ocupa el lugar de la calculadora) */
    .specs-panel {
      display: none; /* Oculto inicialmente */
      background: var(--bg-panel); border: 2px solid var(--neon-blue);
      border-radius: 20px; padding: 20px; width: 100%; height: 100%;
      flex-direction: column; gap: 15px;
      box-shadow: 0 0 20px rgba(0, 210, 255, 0.2);
      animation: slideInRight 0.3s ease forwards;
    }
    .specs-panel.active {
      display: flex;
    }

    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(30px); }
      to { opacity: 1; transform: translateX(0); }
    }

    .specs-header {
      display: flex; justify-content: space-between; align-items: center;
      border-bottom: 1px solid var(--border-color); padding-bottom: 10px;
    }
    .specs-header h3 {
      font-family: var(--font-title); color: var(--neon-blue); font-size: 1.1rem;
      display: flex; align-items: center; gap: 8px;
    }
    .btn-close-specs {
      background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer;
      transition: color 0.3s;
    }
    .btn-close-specs:hover { color: var(--neon-red); }

    /* Contenido interno de las especificaciones */
    .specs-section {
      background: var(--bg-card); padding: 12px;
      border-radius: 12px; border: 1px solid var(--border-color);
    }
    .specs-section h4 {
      font-family: var(--font-title); color: var(--neon-purple);
      margin-bottom: 10px; font-size: 0.9rem;
      display: flex; align-items: center; gap: 6px;
      border-bottom: 1px solid rgba(178, 58, 255, 0.2); padding-bottom: 6px;
    }
    .spec-row { display: flex; justify-content: space-between; font-size: 0.85rem; padding: 4px 0; border-bottom: 1px dashed rgba(255,255,255,0.05); }
    .spec-row span:first-child { color: var(--text-muted); }
    .spec-row span:last-child { color: #fff; font-weight: 600; text-align: right; }

    .games-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .game-tag {
      background: rgba(0, 210, 255, 0.1); border: 1px solid var(--neon-blue);
      color: #fff; padding: 3px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;
    }

    .includes-list { list-style: none; padding: 0; }
    .includes-list li {
      display: flex; align-items: flex-start; gap: 6px;
      margin-bottom: 6px; color: var(--text-main); font-size: 0.85rem; line-height: 1.3;
    }
    .includes-list li i { color: var(--neon-green); font-size: 0.9rem; margin-top: 2px; }

    /* Elementos de la calculadora */
    .calculator-title { font-family: var(--font-title); font-size: 1.3rem; color: var(--neon-blue); display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; }
    .form-group { display: flex; flex-direction: column; gap: 8px; }
    .form-group label { font-weight: 600; color: var(--text-muted); font-size: 0.95rem; }
    .custom-select { background: var(--bg-card); border: 1px solid var(--border-color); color: #fff; padding: 12px; border-radius: 10px; font-family: var(--font-body); font-size: 1rem; outline: none; }
    .hours-control { display: flex; align-items: center; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; }
    .hours-control button { background: transparent; border: none; color: #fff; font-size: 1.2rem; padding: 10px 15px; cursor: pointer; transition: background 0.3s; }
    .hours-control button:hover { background: rgba(255,255,255,0.1); }
    .hours-control input { flex: 1; background: transparent; border: none; color: #fff; text-align: center; font-family: var(--font-title); font-size: 1.1rem; outline: none; width: 100%; }
    .hours-control input::-webkit-outer-spin-button, .hours-control input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .total-display { text-align: center; border-top: 1px solid var(--border-color); padding-top: 20px; margin-top: auto; }
    .total-display p { color: var(--text-muted); font-size: 1rem; margin-bottom: 5px; }
    .total-display h2 { font-family: var(--font-title); font-size: 2.5rem; color: var(--neon-blue); text-shadow: 0 0 15px rgba(0, 210, 255, 0.6); }
    .btn-confirm { background: linear-gradient(90deg, var(--neon-purple), #8a2be2); border: none; color: #fff; padding: 15px; border-radius: 12px; font-family: var(--font-title); font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; }
    .btn-confirm:hover { box-shadow: 0 0 20px var(--neon-purple); transform: scale(1.02); }

    /* ================= FOOTER ================= */
    .footer { background: #0a0b1a; border-top: 1px solid var(--border-color); padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
    .footer__features { display: flex; gap: 30px; }
    .feature { display: flex; align-items: center; gap: 10px; }
    .feature i { font-size: 1.5rem; color: var(--neon-blue); }
    .feature div h4 { font-size: 0.9rem; font-weight: 700; }
    .feature div p { font-size: 0.75rem; color: var(--text-muted); }
    .footer__logo { font-family: var(--font-title); font-size: 1.2rem; display: flex; align-items: center; gap: 10px; color: #fff;}
    .footer__logo i { color: var(--neon-yellow); }

    /* ================= MODALES ================= */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(5px); z-index: 1000; display: none; align-items: center; justify-content: center; }
    .modal-content { background: var(--bg-panel); border: 2px solid var(--neon-purple); border-radius: 20px; width: 500px; padding: 30px; box-shadow: 0 0 40px rgba(178, 58, 255, 0.3); position: relative; text-align: center; max-height: 90vh; overflow-y: auto; }
    .modal-content.selection-modal { width: 650px; text-align: left; }
    
    .modal-close { position: absolute; top: 15px; right: 20px; background: none; border: none; color: var(--text-muted); font-size: 1.5rem; cursor: pointer; transition: color 0.3s; }
    .modal-close:hover { color: var(--neon-red); }
    .modal-icon { background: rgba(178, 58, 255, 0.2); width: 60px; height: 60px; border-radius: 15px; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px; border: 2px solid var(--neon-purple); color: var(--neon-purple); font-size: 1.8rem; }
    .modal-content h3 { font-family: var(--font-title); font-size: 1.5rem; margin-bottom: 20px; text-align: center; }

    .selection-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 15px; margin-bottom: 20px; }
    .selection-card { background: var(--bg-card); border: 2px solid var(--border-color); border-radius: 12px; padding: 15px; text-align: center; cursor: pointer; transition: all 0.3s; position: relative; }
    .selection-card:hover { border-color: var(--neon-purple); box-shadow: 0 0 15px rgba(178, 58, 255, 0.3); transform: translateY(-3px); }
    .selection-card.selected { border-color: var(--neon-blue); box-shadow: 0 0 20px rgba(0, 210, 255, 0.5); background: rgba(0, 210, 255, 0.1); }
    .selection-card.selected::after { content: '\f00c'; font-family: 'Font Awesome 6 Free'; font-weight: 900; position: absolute; top: -8px; right: -8px; background: var(--neon-blue); color: #000; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; }
    .selection-card i { font-size: 2rem; margin-bottom: 10px; color: var(--neon-purple); }
    .selection-card h4 { font-family: var(--font-title); font-size: 1rem; margin-bottom: 5px; }
    
    .pc-status { font-size: 0.75rem; padding: 2px 8px; border-radius: 10px; display: inline-block; margin-top: 8px; font-weight: 700; }
    .pc-status.available { background: rgba(0, 255, 136, 0.15); color: var(--neon-green); border: 1px solid var(--neon-green); }
    .pc-status.occupied { background: rgba(255, 51, 102, 0.15); color: var(--neon-red); border: 1px solid var(--neon-red); }

    .modal-summary { background: var(--bg-card); border-radius: 12px; padding: 15px; margin-bottom: 20px; }
    .summary-row { display: flex; justify-content: space-between; padding: 8px 0; color: var(--text-muted); font-size: 1rem; border-bottom: 1px dashed rgba(255,255,255,0.1); }
    .summary-row:last-child { border-bottom: none; }
    .summary-row span:last-child { color: #fff; font-weight: 600; text-align: right; }
    .summary-row i { margin-right: 8px; width: 20px; text-align: center; }
    
    .modal-total { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 15px; margin-bottom: 20px; font-size: 1.2rem; font-weight: 700; }
    .modal-total span:last-child { color: var(--neon-purple); font-family: var(--font-title); font-size: 1.5rem; }
    .timer-box { background: rgba(255, 51, 102, 0.1); border: 1px solid var(--neon-red); color: var(--neon-red); padding: 10px; border-radius: 10px; font-family: var(--font-title); font-size: 1.2rem; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 25px; }
    .modal-actions { display: flex; gap: 15px; }
    .btn-cancel { flex: 1; background: transparent; border: 1px solid var(--border-color); color: #fff; padding: 12px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: background 0.3s; }
    .btn-cancel:hover { background: rgba(255,255,255,0.1); }
    .btn-process { flex: 2; background: linear-gradient(90deg, var(--neon-purple), #8a2be2); border: none; color: #fff; padding: 12px; border-radius: 10px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.3s; }
    .btn-process:hover { box-shadow: 0 0 15px var(--neon-purple); }

    /* ================= TOAST ================= */
    .toast { position: fixed; top: 20px; right: 20px; background: rgba(0, 255, 136, 0.1); border: 1px solid var(--neon-green); border-left: 5px solid var(--neon-green); color: #fff; padding: 15px 20px; border-radius: 8px; display: none; align-items: center; gap: 15px; z-index: 2000; box-shadow: 0 5px 15px rgba(0, 255, 136, 0.2); }
    .toast i { font-size: 1.5rem; color: var(--neon-green); }
    .toast h4 { font-family: var(--font-title); font-size: 1rem; }
    .toast p { font-size: 0.85rem; color: var(--text-muted); }
    .toast-close { background: none; border: none; color: var(--text-muted); cursor: pointer; margin-left: 10px; }

    /* Responsive */
    @media (max-width: 1100px) {
      .stations-grid { grid-template-columns: repeat(2, 1fr); }
      .right-sidebar { width: 280px; }
    }
    @media (max-width: 900px) {
      .main-container { flex-direction: column; }
      .stations-grid { grid-template-columns: 1fr; }
      .right-sidebar { width: 100%; min-height: auto; margin-top: 20px; }
      .header__nav { display: none; }
      .header__promo-ad { max-width: 200px; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header">
    <!-- Anuncio Dinámico -->
    <div class="header__promo-ad" id="btnOpenPromos">
      <div class="promo-marquee" id="promoText">
        <span>COMBO GAMER GRATIS</span>
        <span>2X1 EN HORAS</span>
        <span>COMBO GAMER GRATIS</span>
        <span>2X1 EN HORAS</span>
      </div>
    </div>

    <nav class="header__nav">
      <a href="#" class="active"><i class="fa-solid fa-house"></i> Inicio</a>
      <div class="dropdown">
        <a href="#" class="btn-contact"><i class="fa-solid fa-envelope"></i> Contacto</a>
        <div class="dropdown-content">
          <a href="https://wa.me/59170012345" target="_blank"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>
          <a href="tel:+59170012345"><i class="fa-solid fa-phone"></i> Llamar</a>
          <a href="#"><i class="fa-solid fa-location-dot"></i> Ubicación</a>
          <a href="mailto:info@levelup.com"><i class="fa-solid fa-envelope-open-text"></i> Enviar Correo</a>
        </div>
      </div>
    </nav>
    
    <div class="header__user">
      <div class="user-avatar">
        <img src="https://i.pravatar.cc/100?img=11" alt="User">
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <div class="main-container">
    
    <main class="center-content">
      <div class="stations-grid">
        
        <!-- PS5 -->
        <div class="station-card active" data-station="ps5" data-price="40">
          <div class="station-card__content">
            <img src="https://images.unsplash.com/photo-1606813907291-d86efa9b94db?q=80&w=600&auto=format&fit=crop" class="station-img" alt="PS5">
            <h3>PS5</h3>
            <p>Juega como un pro</p>
          </div>
          <div class="station-card__buttons">
            <button class="btn-specs" data-target="ps5"><i class="fa-solid fa-list"></i> Especificaciones</button>
            <button class="btn-rent" data-target="modal-select-ps5"><i class="fa-regular fa-clock"></i> Rent Hour ></button>
          </div>
        </div>

        <!-- PC -->
        <div class="station-card" data-station="pc" data-price="50">
          <div class="station-card__content">
            <img src="https://images.unsplash.com/photo-1587202372775-e229f172b9d7?q=80&w=600&auto=format&fit=crop" class="station-img" alt="PC">
            <h3>PC</h3>
            <p>Domina la arena</p>
          </div>
          <div class="station-card__buttons">
            <button class="btn-specs" data-target="pc"><i class="fa-solid fa-list"></i> Especificaciones</button>
            <button class="btn-rent" data-target="modal-select-pc"><i class="fa-regular fa-clock"></i> Rent Hour ></button>
          </div>
        </div>

